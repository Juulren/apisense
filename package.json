    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.100.0",
    "@types/base64-js": "^1.3.2",
    "base64-js": "^1.5.1",
    "expo": "~57.0.30",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "mqtt": "^5.16.1",
