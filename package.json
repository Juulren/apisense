{
  "name": "apisense",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "expo export --platform web",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0",
    "nativewind": "4.2.7",
    "expo-router": "~57.0.28",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "expo-font": "~57.0.4",
    "react-native-screens": "~4.26.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "@expo/metro-runtime": "~57.0.17"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.2.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0",
    "babel-preset-expo": "~57.0.0"
  }
}
