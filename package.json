{
  "name": "apisense",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "expo export --platform web && node scripts/prepare-offline.mjs",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write src supabase/functions *.json *.js",
    "preview": "node scripts/serve-web.mjs"
  },
